{
  "name": "shunyalabs-web-automation",
  "version": "1.4.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:dashboard:publish",
    "test:headed": "npx playwright test tests/modules --headed",
    "test:dashboard": "npx playwright test tests/modules && node dashboard/generate-dashboard.js",
    "report": "npx playwright show-report reports/html-report",
    "dashboard": "node dashboard/generate-dashboard.js",
    "dashboard:open": "node dashboard/generate-dashboard.js && open dashboard/index.html",
    "dashboard:prepare": "node dashboard/generate-dashboard.js",
    "dashboard:publish": "node dashboard/generate-dashboard.js && bash scripts/publish-dashboard.sh",
    "dashboard:deploy": "bash scripts/deploy-dashboard.sh",
    "test:dashboard:deploy": "npx playwright test tests/modules && node dashboard/generate-dashboard.js && bash scripts/deploy-dashboard.sh",
    "test:dashboard:publish": "bash scripts/run-tests-and-dashboard.sh",
    "snapshot:pages": "npx playwright test tests/snapshots/generate-page-snapshots.spec.js",
    "test:visual": "npx playwright test tests/visual",
    "test:visual:update": "npx playwright test tests/visual --update-snapshots",
    "test:contact-daily-mail": "node scripts/contact-daily-e2e-mail.js",
    "generate:modules": "node scripts/generate-module-pages.js",
    "combine-reports": "node utils/combine-reports.js",
    "test-sheets": "node test-sheets-connection.js",
    "parse:figma": "node scripts/parse-figma-specs.js",
    "parse:figma:generate": "node scripts/parse-figma-specs.js --generate",
    "test:design": "npx playwright test tests/modules --grep \"design compliance\"",
    "test:browsers": "node scripts/run-multi-browser-tests.js",
    "email:preview": "node scripts/email-daily-report.js --preview",
    "test:desktop": "npx playwright test tests/modules --project=desktop-chrome",
    "test:mobile": "npx playwright test tests/modules --project=mobile-ios",
    "test:desktop-chrome": "npx playwright test tests/modules --project=desktop-chrome",
    "test:desktop-safari": "npx playwright test tests/modules --project=desktop-safari",
    "test:mobile-ios": "npx playwright test tests/modules --project=mobile-ios",
    "test:mobile-android": "npx playwright test tests/modules --project=mobile-android",
    "sync:live": "node scripts/sync-live-site.js",
    "baseline:design": "npm run baseline:design:desktop && npm run baseline:design:mobile",
    "baseline:design:desktop": "npx playwright test tests/snapshots/generate-design-baselines.spec.js --config=playwright.desktop-baseline.config.js",
    "baseline:design:mobile": "npx playwright test tests/snapshots/generate-design-baselines.spec.js --config=playwright.mobile-baseline.config.js",
    "snapshot:pages:desktop": "npx playwright test tests/snapshots/generate-page-snapshots.spec.js --project=desktop",
    "snapshot:pages:mobile": "npx playwright test tests/snapshots/generate-page-snapshots.spec.js --project=mobile"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "nodemailer": "^6.9.16",
    "xlsx": "^0.18.5"
  }
}
